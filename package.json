  "bugs": {
    "url": "https://github.com/tche562/fullstack-mini-ecommerce/issues"
  },
  "homepage": "https://github.com/tche562/fullstack-mini-ecommerce#readme",
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
